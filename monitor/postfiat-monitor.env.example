# /etc/postfiat-monitor.env - config for postfiat-monitor
#
# ntfy.sh topics are public to anyone who knows the name, so use a long random
# topic (the installer generates one if you don't set it). Subscribe to it in
# the ntfy app (Android/iOS/web) to get push alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Access token if you use a protected topic or self-hosted ntfy (optional)
NTFY_TOKEN=

# Label shown in alerts. Defaults to a generic name so alerts don't leak the hostname.
NODE_LABEL=postfiat-node

# States considered healthy. Add "syncing" etc. if you want to tolerate them.
HEALTHY_STATES="full proposing"

# Re-send an alert every N minutes while still unhealthy. 0 = alert once only.
REMIND_MINUTES=0
