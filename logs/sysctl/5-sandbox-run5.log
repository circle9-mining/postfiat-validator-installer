-- /tmp/tmp.J9TsulnoYr/etc/sysctl.d/90-postfiat-hardening.conf (sandbox copy)
  # Managed by pft-sysctl.sh (postfiat-validator-installer/sysctl). Rollback: pft-sysctl.sh rollback
  # Never sets net.ipv4.ip_forward or net.bridge.* (Docker owns them).
  # reverse-path filter, loose mode (strict breaks asymmetric/Docker routing)
  net.ipv4.conf.all.rp_filter = 2
  # same for interfaces created later (veths)
  net.ipv4.conf.default.rp_filter = 2
  # SYN-flood resistance on the public peer port 2559
  net.ipv4.tcp_syncookies = 1
  # ignore ICMP redirects (route hijack)
  net.ipv4.conf.all.accept_redirects = 0
  # same for new interfaces
  net.ipv4.conf.default.accept_redirects = 0
  # ignore redirects even from listed gateways
  net.ipv4.conf.all.secure_redirects = 0
  # same for new interfaces
  net.ipv4.conf.default.secure_redirects = 0
  # a node host is not a router for its LAN
  net.ipv4.conf.all.send_redirects = 0
  # same for new interfaces
  net.ipv4.conf.default.send_redirects = 0
  # ignore ICMPv6 redirects
  net.ipv6.conf.all.accept_redirects = 0
  # same for new interfaces
  net.ipv6.conf.default.accept_redirects = 0
  # drop source-routed packets
  net.ipv4.conf.all.accept_source_route = 0
  # same for new interfaces
  net.ipv4.conf.default.accept_source_route = 0
  # drop IPv6 source-routed packets
  net.ipv6.conf.all.accept_source_route = 0
  # same for new interfaces
  net.ipv6.conf.default.accept_source_route = 0
  # log impossible source addresses (kernel rate-limited)
  net.ipv4.conf.all.log_martians = 1
  # same for new interfaces
  net.ipv4.conf.default.log_martians = 1
  # no smurf amplification
  net.ipv4.icmp_echo_ignore_broadcasts = 1
  # do not log bogus ICMP errors
  net.ipv4.icmp_ignore_bogus_error_responses = 1
  # hide kernel pointers from everyone, incl. root tools
  kernel.kptr_restrict = 2
  # kernel log only for CAP_SYSLOG
  kernel.dmesg_restrict = 1
  # no unprivileged eBPF (2 = revertible; 1 locks until reboot)
  kernel.unprivileged_bpf_disabled = 2
  # ptrace only of descendants (3 would be irreversible)
  kernel.yama.ptrace_scope = 1
  # no hardlinks to files you do not own
  fs.protected_hardlinks = 1
  # no following others symlinks in sticky dirs
  fs.protected_symlinks = 1
  # no O_CREAT on others FIFOs in sticky dirs
  fs.protected_fifos = 1
  # no O_CREAT on others regular files in sticky dirs
  fs.protected_regular = 2
  # no core dumps of setuid processes (key material in memory)
  fs.suid_dumpable = 0

