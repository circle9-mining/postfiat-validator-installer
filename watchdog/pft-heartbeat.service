[Unit]
Description=pft-heartbeat: push a signed heartbeat to the watchdog host
Documentation=https://github.com/darkmatter-sudo/postfiat-validator-installer/tree/main/watchdog
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# exit 1 = local RPC down; a heartbeat saying so was still sent
SuccessExitStatus=1
ExecStart=/usr/local/bin/pft-heartbeat
TimeoutStartSec=45
